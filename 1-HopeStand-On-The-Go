```

### File: `functions.php`

Paste this:

```php
<?php
/**
 * HopeStand Core Theme functions.
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

function hopestand_core_enqueue_styles() {
	wp_enqueue_style(
		'hopestand-core-style',
		get_stylesheet_uri(),
		array(),
		'0.1.0'
	);
}
add_action( 'wp_enqueue_scripts', 'hopestand_core_enqueue_styles' );
```

### File: `index.php`

Paste this:

```php
<?php
get_header();
?>

<main id="main-content">
	<?php
	if ( have_posts() ) {
		while ( have_posts() ) {
			the_post();
			the_content();
		}
	}
	?>
</main>

<?php
get_footer();
```

### File: `.gitignore`

Paste this:

```gitignore
.DS_Store
Thumbs.db
*.log
.env
.env.*
node_modules/
vendor/
```

